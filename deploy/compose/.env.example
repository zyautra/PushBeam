# PushBeam 배포 설정. 이 파일을 .env로 복사해서 값을 채운다 (.env는 git에 올라가지 않는다).

# 외부에서 접속할 도메인. DNS A/AAAA 레코드가 이 서버를 가리켜야 한다.
PUSHBEAM_DOMAIN=pushbeam.example.com
# Let's Encrypt 인증서 만료 알림을 받을 이메일 (선택)
ACME_EMAIL=

# 데이터, 비밀 값, 인증서를 둘 Host 디렉터리 (저장소 밖 권장)
#   $PUSHBEAM_HOME/secrets/firebase-service-account.json  서버용 Firebase 서비스 계정 키
#   $PUSHBEAM_HOME/secrets/operator-token                 Operator Token (pushbeam-admin token generate)
#   $PUSHBEAM_HOME/data/                                  SQLite DB, 백업
PUSHBEAM_HOME=/srv/pushbeam

# Firebase 프로젝트 번호 (프로젝트 설정 → 일반 → 프로젝트 번호)
PUSHBEAM_FIREBASE_PROJECT_NUMBER=000000000000

# App Distribution 테스터 그룹 alias (없으면 서버가 만든다)
PUSHBEAM_DISTRIBUTION_GROUP=pushbeam-members

# 시간대를 아직 보내지 않은 Member에게 쓸 시간대
PUSHBEAM_DEFAULT_TIME_ZONE=Asia/Seoul
