# PushBeam deployment settings. Copy this file to .env and fill in the values (.env is git-ignored).

# Public domain. A DNS A/AAAA record must point at this host.
PUSHBEAM_DOMAIN=pushbeam.example.com
# Email for Let's Encrypt expiry notices (optional)
ACME_EMAIL=

# Host directory for data, secrets and certificates (outside the repository recommended)
#   $PUSHBEAM_HOME/secrets/firebase-service-account.json  Firebase service account key for the server
#   $PUSHBEAM_HOME/secrets/operator-token                 Operator Token (pushbeam-admin token generate)
#   $PUSHBEAM_HOME/data/                                  SQLite database and backups
PUSHBEAM_HOME=/srv/pushbeam

# Firebase project number (Project settings → General → Project number)
PUSHBEAM_FIREBASE_PROJECT_NUMBER=000000000000

# App Distribution tester group alias (created by the server if missing)
PUSHBEAM_DISTRIBUTION_GROUP=pushbeam-members

# Time zone for Members whose device has not reported one yet
PUSHBEAM_DEFAULT_TIME_ZONE=Asia/Seoul
